{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Ocean's main window: core IPC/events, native open dialog, and fs watch.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "fs:allow-watch",
    "core:tray:default",
    "core:menu:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "notification:default",
    "deep-link:default"
  ]
}
