{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ocean",
  "version": "0.1.0",
  "identifier": "dev.ocean.surface",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ocean",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ocean"]
      }
    }
  }
}
